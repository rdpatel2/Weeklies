# Copy to .env (git-ignored) and fill in. `flask run` loads .env automatically.

# Signs session cookies. Use a long random value and keep it out of git:
#   python -c "import secrets; print(secrets.token_hex(32))"
# If unset, the app generates a random key at startup (logins reset on restart).
WEEKLIES_SECRET_KEY=

# Uncomment for auto-reload and the interactive debugger during local development.
# Never enable on a server others can reach.
# FLASK_DEBUG=1
